"g. :src:`psutil/_pslinux.py`)."
msgstr ""

#: ../../../devguide.rst:170
msgid "If needed, add C code in ``psutil/arch/{platform}/file.c``."
msgstr ""

#: ../../../devguide.rst:171
msgid ""
"Add a generic test in :src:`tests/test_system.py` or :src:`tests/"
"test_process.py`."
msgstr ""

#: ../../../devguide.rst:173
msgid "Add a platform-specific test in ``tests/test_{platform}.py``."
msgstr ""

