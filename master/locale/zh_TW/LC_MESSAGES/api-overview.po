"...     psutil.cpu_percent(interval=1)\n"
"...\n"
"4.0\n"
"5.9\n"
"3.8\n"
">>>\n"
">>> for x in range(3):\n"
"...     psutil.cpu_percent(interval=1, percpu=True)\n"
