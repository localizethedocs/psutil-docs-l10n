#: ../../../api.rst:1214
msgid ""
"Context manager that speeds up retrieval of multiple process attributes. "
"Internally, many attributes (e.g. :meth:`name`, :meth:`ppid`, :meth:`uids`, :"
"meth:`create_time`, ...) share the same underlying system call; within this "
"context, those calls are executed once and results are cached, avoiding "
"redundant syscalls."
msgstr ""

#: ../../../api.rst:1220
msgid ""
">>> import psutil\n"
">>> p = psutil.Process()\n"
">>> with p.oneshot():\n"
"...     p.name()  # actual syscall\n"
"...     p.cpu_times()  # from cache\n"
"...     p.create_time()  # from cache\n"
"...     p.ppid()  # from cache\n"
"...     p.status()  # from cache\n"
"...\n"
">>>"
msgstr ""

