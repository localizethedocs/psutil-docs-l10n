"`migration guide <migration-8.0>`."
msgstr ""

#: ../../../api.rst:1489
msgid ""
"Get or set process :term:`resource limits <resource limit>`. *resource* must "
"be one of the :ref:`RLIMIT_* <const-proc-rlimit>` constants. *limits* is an "
"optional ``(soft, hard)`` tuple. If provided, the method sets the limits; if "
"omitted, it returns the current ``(soft, hard)`` tuple. This is the same as "
"stdlib :func:`resource.getrlimit` and :func:`resource.setrlimit`, but can be "
"used for any process PID."
msgstr ""

#: ../../../api.rst:1496
msgid ""
">>> import psutil\n"
">>> p = psutil.Process()\n"
">>> p.rlimit(psutil.RLIMIT_NOFILE, (128, 128))   # max 128 file descriptors\n"
">>> p.rlimit(psutil.RLIMIT_FSIZE, (1024, 1024))  # max file size 1024 bytes\n"
">>> p.rlimit(psutil.RLIMIT_FSIZE)                # get current limits "
"of ...\n"
"(1024, 1024)"
msgstr ""

