#: ../../../api.rst:1459
msgid ""
"Get or set process :term:`I/O niceness <ionice>` (priority). Called with no "
"arguments (get), returns a ``(ioclass, value)`` named tuple on Linux or an "
"*ioclass* integer on Windows. Called with *ioclass* (one of the :ref:"
"`IOPRIO_* <const-proc-ioprio>` constants), sets the I/O priority. On Linux, "
"an additional *value* ranging from ``0`` to ``7`` can be specified to "
"further adjust the priority level specified by *ioclass*."
msgstr ""

#: ../../../api.rst:1466
msgid ""
">>> import psutil\n"
">>> p = psutil.Process()\n"
">>> if psutil.LINUX:\n"
"...     p.ionice(psutil.IOPRIO_CLASS_RT, value=7)  # highest\n"
"... else:\n"
"...     p.ionice(psutil.IOPRIO_HIGH)\n"
"...\n"
">>> p.ionice()  # get\n"
"pionice(ioclass=<ProcessIOPriority.IOPRIO_CLASS_RT: 1>, value=7)"
msgstr ""

#: ../../../api.rst:1480
msgid "Windows: accept new :data:`IOPRIO_* <psutil.IOPRIO_VERYLOW>` constants."
msgstr ""

#: ../../../api.rst:1483
msgid ""
