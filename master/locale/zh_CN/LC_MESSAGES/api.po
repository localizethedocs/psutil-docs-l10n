#: ../../../api.rst:1615
msgid ""
">>> import psutil\n"
">>> p = psutil.Process()\n"
">>> p.cpu_times()\n"
"pcputimes(user=0.03, system=0.67, children_user=0.0, children_system=0.0, "
"iowait=0.08)\n"
">>> sum(p.cpu_times()[:2])  # cumulative, excluding children and iowait\n"
"0.70"
