#: ../../../migration/index.rst:10
msgid "8.0"
msgstr ""

#: ../../../migration/index.rst:14
msgid ""
"A major breaking release. Process memory APIs were reorganized, many names "
"deprecated, Python 3.6 and 3.7 dropped."
msgstr ""

#: ../../../migration/index.rst:17
msgid "7.0"
msgstr ""

#: ../../../migration/index.rst:21
msgid "``Process.memory_info_ex()`` removed, Python 2.7 dropped."
msgstr ""

#: ../../../migration/index.rst:23
msgid "6.0"
msgstr ""

#: ../../../migration/index.rst:27
msgid ""
"``disk_partitions()`` lost two fields, ``process_iter()`` no longer checks "
"for PID reuse, ``Process.connections()`` renamed."
msgstr ""

