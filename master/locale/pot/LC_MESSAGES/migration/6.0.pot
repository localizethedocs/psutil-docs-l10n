#: ../../../migration/6.0.rst:4
msgid "Migrating to 6.0"
msgstr ""

#: ../../../migration/6.0.rst:7
msgid "Breaking changes"
msgstr ""

#: ../../../migration/6.0.rst:10
msgid ":func:`disk_partitions` lost two fields"
msgstr ""

#: ../../../migration/6.0.rst:12
msgid ""
"The :field:`maxfile` and :field:`maxpath` fields were removed, so positional "
"unpacking no longer works."
msgstr ""

#: ../../../migration/6.0.rst:15
msgid ""
"# old (ValueError)\n"
"device, mountpoint, fstype, opts, maxfile, maxpath = part\n"
"\n"
"# new\n"
"device, mountpoint, fstype, opts = (\n"
"    part.device, part.mountpoint, part.fstype, part.opts\n"
")"
msgstr ""

#: ../../../migration/6.0.rst:26
msgid ":func:`process_iter` no longer checks for PID reuse"
msgstr ""

#: ../../../migration/6.0.rst:28
msgid ""
"This makes it ~20× faster. If you relied on that check, "
"call :meth:`Process.is_running` yourself."
msgstr ""

#: ../../../migration/6.0.rst:31
msgid ""
"# old\n"
"for p in psutil.process_iter():\n"
"    print(p.pid)\n"
"\n"
"# new\n"
"for p in psutil.process_iter():\n"
"    if p.is_running():\n"
"        print(p.pid)"
msgstr ""

#: ../../../migration/6.0.rst:43
msgid "Deprecations"
msgstr ""

#: ../../../migration/6.0.rst:46
msgid ":meth:`Process.connections` renamed to :meth:`Process.net_connections`"
msgstr ""

#: ../../../migration/6.0.rst:48
msgid ""
"The old name still works but raises :exc:`DeprecationWarning`. It will be "
"removed in 9.0."
msgstr ""

#: ../../../migration/6.0.rst:51
msgid ""
"# old\n"
"p.connections(kind=\"tcp\")  # DeprecationWarning\n"
"\n"
"# new\n"
"p.net_connections(kind=\"tcp\")"
msgstr ""
