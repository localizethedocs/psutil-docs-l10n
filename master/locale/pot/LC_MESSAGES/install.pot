#: ../../../install.rst:2
msgid "Install psutil"
msgstr ""

#: ../../../install.rst:5
msgid "Linux, Windows, macOS (wheels)"
msgstr ""

#: ../../../install.rst:7
msgid ""
"Prebuilt wheels are distributed for these platforms, so a C compiler is not "
"required. Install psutil with:"
msgstr ""

#: ../../../install.rst:10
msgid "pip install psutil"
msgstr ""

#: ../../../install.rst:14
msgid ""
"Inside a virtual environment you can also use `uv <https://docs.astral.sh/uv/"
">`_:"
msgstr ""

#: ../../../install.rst:17
msgid "uv pip install psutil"
msgstr ""

#: ../../../install.rst:21
msgid ""
"If no wheel is available for your platform or architecture, pip will build "
"psutil from source (see below)."
msgstr ""

#: ../../../install.rst:27
msgid "Build psutil from source"
msgstr ""

#: ../../../install.rst:29
msgid ""
"Building psutil from source requires a C compiler and the Python development "
"headers. On Linux, FreeBSD, NetBSD, OpenBSD and Solaris, the `install-"
"sysdeps.sh`_ script can install them for you:"
msgstr ""

#: ../../../install.rst:33
msgid ""
"curl -fsSL \\\n"
"    https://raw.githubusercontent.com/giampaolo/psutil/master/scripts/"
"internal/install-sysdeps.sh | sh"
msgstr ""

#: ../../../install.rst:38
msgid "Alternatively, install them manually as described below."
msgstr ""

#: ../../../install.rst:41
msgid "Linux"
msgstr ""

#: ../../../install.rst:43
msgid "Debian / Ubuntu:"
msgstr ""

#: ../../../install.rst:45
msgid "sudo apt-get install gcc python3-dev"
msgstr ""

#: ../../../install.rst:49
msgid "Red Hat / CentOS:"
msgstr ""

#: ../../../install.rst:51
msgid "sudo yum install gcc python3-devel"
msgstr ""

#: ../../../install.rst:55
msgid "Fedora:"
msgstr ""

#: ../../../install.rst:57
msgid "sudo dnf install gcc python3-devel"
msgstr ""

#: ../../../install.rst:61
msgid "Arch:"
msgstr ""

#: ../../../install.rst:63
msgid "sudo pacman -S gcc python"
msgstr ""

#: ../../../install.rst:67
msgid "Alpine:"
msgstr ""

#: ../../../install.rst:69
msgid "sudo apk add gcc python3-dev musl-dev linux-headers"
msgstr ""

#: ../../../install.rst:0 ../../../install.rst:76
msgid "Windows"
msgstr ""

#: ../../../install.rst:78
msgid ""
"To build psutil from source, install `Microsoft C++ Build Tools <https://"
"visualstudio.microsoft.com/visual-cpp-build-tools/>`_ with the \"Desktop "
"development with C++\" option selected."
msgstr ""

#: ../../../install.rst:81
msgid "MinGW is not supported."
msgstr ""

#: ../../../install.rst:82
msgid ""
"To clone psutil's Git repository and build or develop it locally, first "
"install `Git for Windows`_ and GNU Make. To install GNU Make, open "
"PowerShell and run:"
msgstr ""

#: ../../../install.rst:86
msgid "winget install --exact --id ezwinports.make"
msgstr ""

#: ../../../install.rst:90
msgid "Close and reopen Git Bash, then follow :ref:`build_and_install`."
msgstr ""

#: ../../../install.rst:93
msgid "macOS"
msgstr ""

#: ../../../install.rst:95
msgid "Install the Xcode command line tools:"
msgstr ""

#: ../../../install.rst:97
msgid "xcode-select --install"
msgstr ""

#: ../../../install.rst:102
msgid "BSD"
msgstr ""

#: ../../../install.rst:104
msgid "FreeBSD:"
msgstr ""

#: ../../../install.rst:106
msgid "pkg install python3"
msgstr ""

#: ../../../install.rst:110
msgid "OpenBSD:"
msgstr ""

#: ../../../install.rst:112
msgid ""
"export PKG_PATH=https://cdn.openbsd.org/pub/OpenBSD/`uname -r`/packages/"
"`uname -m`/\n"
"pkg_add -v python%3"
msgstr ""

#: ../../../install.rst:117
msgid ""
"NetBSD: pkgsrc has no version-agnostic python3 package, so choose one of the "
"available Python 3 versions. For example:"
msgstr ""

#: ../../../install.rst:120
msgid ""
"export PKG_PATH=\"https://cdn.netbsd.org/pub/pkgsrc/packages/NetBSD/`uname "
"-m`/`uname -r`/All\"\n"
"pkg_add -v pkgin\n"
"pkgin update\n"
"pkgin install python314"
msgstr ""

#: ../../../install.rst:128
msgid "Solaris"
msgstr ""

#: ../../../install.rst:130
msgid "pkg install developer/gcc"
msgstr ""

#: ../../../install.rst:134
msgid ""
"If ``cc`` is unavailable, set ``CC=gcc`` when running the commands "
"in :ref:`build_and_install`."
msgstr ""

#: ../../../install.rst:138
msgid "AIX"
msgstr ""

#: ../../../install.rst:140
msgid ""
"``install-sysdeps.sh`` has no AIX branch. Install a C compiler and the "
"Python development headers from the `AIX Toolbox`_."
msgstr ""

#: ../../../install.rst:146
msgid "Build and install"
msgstr ""

#: ../../../install.rst:148
msgid "To build and install psutil from a Git checkout:"
msgstr ""

#: ../../../install.rst:150
msgid ""
"git clone https://github.com/giampaolo/psutil.git\n"
"cd psutil\n"
"make install-sysdeps\n"
"make build\n"
"make install"
msgstr ""

#: ../../../install.rst:160
msgid ""
"By default C source files are compiled in parallel, one job per CPU, which "
"makes building from source 2x to 3.6x faster. "
"Use :envvar:`PSUTIL_BUILD_JOBS` to change the number of jobs."
msgstr ""

#: ../../../install.rst:165
msgid "Troubleshooting"
msgstr ""

#: ../../../install.rst:168
msgid "Install pip"
msgstr ""

#: ../../../install.rst:170
msgid "Python installations normally include pip. If it is missing, first try:"
msgstr ""

#: ../../../install.rst:172
msgid "python3 -m ensurepip --upgrade"
msgstr ""

#: ../../../install.rst:176
msgid ""
"Some OS-packaged Python installations do not include ``ensurepip``. There, "
"either install the pip package or download `get-pip.py`_ and run:"
msgstr ""

#: ../../../install.rst:179
msgid "python3 get-pip.py"
msgstr ""

#: ../../../install.rst:184
msgid "Permission errors"
msgstr ""

#: ../../../install.rst:186
msgid ""
"If you encounter permission errors, install psutil inside a virtual "
"environment instead of modifying the system Python installation:"
msgstr ""

#: ../../../install.rst:0
msgid "Unix"
msgstr ""

#: ../../../install.rst:193
msgid ""
"python3 -m venv .venv\n"
"source .venv/bin/activate\n"
"python -m pip install psutil"
msgstr ""

#: ../../../install.rst:201
msgid ""
"py -m venv .venv\n"
".venv\\Scripts\\Activate.ps1\n"
"python -m pip install psutil"
msgstr ""
