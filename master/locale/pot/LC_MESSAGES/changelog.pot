msgid "7.1.3 — 2025-11-02"
msgstr ""

#: ../../../changelog.rst:553
msgid ""
":gh:`2667`: enforce ``clang-format`` on all C and header files. It is now "
"the mandatory formatting style for all C sources."
msgstr ""

#: ../../../changelog.rst:555
msgid ""
