msgid ""
":gh:`2893`, [Windows], :label:`breaking`: Windows Vista, 7, 8, 8.1 and their "
"server counterparts (minimum is now Windows 10 / Server 2016)."
msgstr ""

#: ../../../changelog.rst:146
msgid ":gh:`2936`, [Windows], :label:`breaking`: PyPy older than 7.3.14."
msgstr ""

#: ../../../changelog.rst:147
msgid ""
":gh:`2987`, [macOS], :label:`breaking`: macOS 10.7 and 10.8 (minimum is now "
"10.9)."
msgstr ""

#: ../../../changelog.rst:150 ../../../changelog.rst:499
#: ../../../changelog.rst:708 ../../../changelog.rst:753
#: ../../../changelog.rst:793 ../../../changelog.rst:999
#: ../../../changelog.rst:1029 ../../../changelog.rst:1178
