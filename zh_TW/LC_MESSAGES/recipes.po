#: ../../../recipes.rst:414
msgid ""
"Show real-time swap activity *(Linux, BSD)*. ``sout`` (:term:`swap-out`) is "
"the key metric: a non-zero and growing rate means the OS is moving memory "
"from RAM to disk because RAM is full. ``sin`` (:term:`swap-in`) alone is not "
"alarming; it just means the system is moving previously evicted pages back "
"into RAM. High ``sin`` and ``sout`` together may indicate heavy swapping (:"
"term:`thrashing`)."
msgstr ""

#: ../../../recipes.rst:420
msgid ""
"import psutil, time\n"
"\n"
"def swap_activity(interval=1):\n"
"    before = psutil.swap_memory()\n"
"    while True:\n"
"        time.sleep(interval)\n"
"        after = psutil.swap_memory()\n"
"        sin  = after.sin  - before.sin\n"
"        sout = after.sout - before.sout\n"
"        print(\"swap-in={}/s  swap-out={}/s  used={}%\".format(\n"
"            psutil.bytes2human(sin), psutil.bytes2human(sout), after."
"percent))\n"
"        before = after"
msgstr ""

#: ../../../recipes.rst:435
msgid ""
"swap-in=0.0B/s  swap-out=0.0B/s  used=23%\n"
"swap-in=0.0B/s  swap-out=1.2M/s  used=24%"
msgstr ""

