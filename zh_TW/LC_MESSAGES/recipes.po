#: ../../../recipes.rst:174
msgid ""
"Top N processes by :term:`cumulative <cumulative counter>` disk read + write "
"bytes (similar to ``iotop``):"
msgstr ""

#: ../../../recipes.rst:177
msgid ""
"import psutil\n"
"\n"
"def top_io_procs(n=5):\n"
"    procs = []\n"
"    for p in psutil.process_iter([\"io_counters\"]):\n"
"        io = p.io_counters()\n"
"        procs.append((io.read_bytes + io.write_bytes, p))\n"
"    procs.sort(key=lambda x: x[0], reverse=True)\n"
"    return procs[:n]"
msgstr ""

#: ../../../recipes.rst:191
