#: ../../../recipes.rst:159
msgid "Top N processes by :term:`cumulative <cumulative counter>` CPU time:"
msgstr ""

#: ../../../recipes.rst:161
msgid ""
"import psutil\n"
"\n"
"def top_cpu_procs(n=3):\n"
"    procs = sorted(\n"
"        psutil.process_iter([\"name\", \"cpu_times\"]),\n"
"        key=lambda p: sum(p.cpu_times()[:2]),\n"
"    )\n"
"    return [(p.pid, p.name(), sum(p.cpu_times())) for p in procs[-n:]]"
