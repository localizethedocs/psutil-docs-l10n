msgid ""
"~/svn/psutil$ ./scripts/procsmem.py\n"
"PID     User    Cmdline                            USS     PSS    Swap     "
"RSS\n"
"==============================================================================\n"
"...\n"
"3986    giampao /usr/bin/python3 /usr/bin/indi   15.3M   16.6M      0B   "
"25.6M\n"
