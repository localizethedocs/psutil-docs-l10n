"26.7M\n"
"3991    giampao python /usr/bin/hp-systray -x    19.0M   23.3M      0B   "
"40.7M\n"
"3830    giampao /usr/bin/ibus-daemon --daemoni   19.0M   19.0M      0B   "
"21.4M\n"
"20529   giampao /opt/sublime_text/plugin_host    19.9M   20.1M      0B   "
"22.0M\n"
"3990    giampao nautilus -n                      20.6M   29.9M      0B   "
"50.2M\n"
"3898    giampao /usr/lib/unity/unity-panel-ser   27.1M   27.9M      0B   "
"37.7M\n"
